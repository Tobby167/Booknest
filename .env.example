NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required only when online Stripe payments are enabled.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
STRIPE_SECRET_KEY=sk_test_or_live_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# AES-256-CBC key used to encrypt WhatsApp/Telegram credentials stored in the DB.
# Must be a 64-char hex string OR a 32-char UTF-8 string.
ENCRYPTION_KEY=your_64_char_hex_or_32_char_string_here

# Secret header sent by the cron scheduler to /api/cron/reminders.
CRON_SECRET=your_cron_secret_here

# ─── BookNest Platform WhatsApp (shared number — set once by the developer) ───
# Register a dedicated phone number on Meta Cloud API (meta.com/developers).
# This number is shared by all businesses on the platform — owners just enable a toggle.
PLATFORM_WA_PHONE_NUMBER_ID=
PLATFORM_WA_ACCESS_TOKEN=
PLATFORM_WA_APP_SECRET=
PLATFORM_WA_VERIFY_TOKEN=booknest_wa_verify_secret
